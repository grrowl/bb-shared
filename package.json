{
  "name": "bb-plugin-shared",
  "version": "0.1.0",
  "description": "Share bb threads with guests via scoped, revocable tokens. The repo root is the plugin; packages/ holds the vendored tunnel workspaces and worker/ the Cloudflare Worker.",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Shared",
    "description": "Share bb threads with guests via scoped, revocable tokens.",
    "branding": {
      "icon": "Sent"
    },
    "server": "./plugin/server.ts",
    "app": "./plugin/app.tsx"
  },
  "workspaces": [
    "packages/*",
    "worker"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bb-shared/tunnel-client": "*",
    "@bb-shared/tunnel-contract": "*",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudflare": "^7.1.0",
    "clsx": "^2.1.1",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.11"
  }
}
