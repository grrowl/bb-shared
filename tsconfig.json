{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./plugin/*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "plugin/server.ts",
    "plugin/app.tsx",
    "plugin/authz",
    "plugin/components",
    "plugin/lib",
    "plugin/hooks",
    "plugin/share-popover",
    "plugin/nav-panel",
    "plugin/worker-lifecycle"
  ]
}
